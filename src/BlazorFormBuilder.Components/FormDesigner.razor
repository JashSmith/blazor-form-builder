@inject IEnumerable<IFormFieldPlugin> AvailablePlugins
@inject IFormDefinitionStore Store

<div class="designer-shell">
    <header class="app-toolbar">
        <div>
            <span class="eyebrow">BLAZOR FORM BUILDER</span>
            <h1>@(isPreview ? "Form preview" : "Form designer")</h1>
        </div>
        <div class="toolbar-actions">
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <span class="status @(saveSucceeded ? "success" : null)">@statusMessage</span>
            }
            <button class="secondary" @onclick="ToggleJson" disabled="@isPreview">JSON</button>
            <button data-testid="toggle-form-preview" class="secondary" @onclick="TogglePreview">@(isPreview ? "Back to designer" : "Preview form")</button>
            <button data-testid="save-form" class="primary" @onclick="SaveAsync" disabled="@isPreview">Save form</button>
        </div>
    </header>

    @if (isPreview)
    {
        <FormPreview Definition="Definition" />
    }
    else
    {
        <div class="form-designer">
            <aside class="designer-panel toolbox" aria-label="Field toolbox">
                <h2>Fields</h2>
                <p class="muted">Drag a field onto the canvas or click to append.</p>
                @foreach (var plugin in Plugins)
                {
                    <button class="toolbox-item" data-field-type="@plugin.Type"
                            draggable="true"
                            @ondragstart="() => BeginPluginDrag(plugin.Type)"
                            @onclick="() => AddField(plugin)">
                        <span class="drag-handle">⋮⋮</span> @plugin.DisplayName
                    </button>
                }
            </aside>

            <main class="designer-canvas" @ondragover:preventDefault @ondrop="DropAtEnd">
                <div class="canvas-heading">
                    <div>
                        <span class="eyebrow">FORM NAME</span>
                        <input class="form-name" aria-label="Form name" @bind="Definition.Name" @bind:event="oninput" @bind:after="MarkDirty" />
                    </div>
                    <span class="field-count">@Definition.Fields.Count field@(Definition.Fields.Count == 1 ? null : "s")</span>
                </div>

                @if (validationRequested && DefinitionIssues.Count > 0)
                {
                    <div class="validation-summary" role="alert">
                        <strong>Fix @DefinitionIssues.Count issue@(DefinitionIssues.Count == 1 ? null : "s") before saving.</strong>
                        <ul>
                            @foreach (var issue in DefinitionIssues)
                            {
                                <li>@issue.Message</li>
                            }
                        </ul>
                    </div>
                }

                @if (Definition.Fields.Count == 0)
                {
                    <button class="empty-state" @onclick="AddFirstField">
                        <strong>Your canvas is empty</strong>
                        <span>Add the first field to start designing.</span>
                    </button>
                }
                else
                {
                    <div class="field-list">
                        @for (var index = 0; index < Definition.Fields.Count; index++)
                        {
                            var item = Definition.Fields[index];
                            var plugin = PluginsByType[item.Type];
                            <article @key="item.Id"
                                     draggable="true"
                                     class="field-card @(selectedFieldId == item.Id ? "selected" : null)"
                                     @onclick="() => Select(item.Id)"
                                     @ondragstart="() => BeginFieldDrag(item.Id)"
                                     @ondragover:preventDefault
                                     @ondrop="() => DropBefore(item.Id)"
                                     @ondrop:stopPropagation>
                                <DynamicComponent Type="plugin.DesignerComponentType"
                                                  Parameters="FormFieldComponentParameters.ForDesigner(item)" />
                                <div class="field-actions">
                                    <button title="Move up" disabled="@(item.Order == 0)" @onclick="() => Move(item.Id, -1)" @onclick:stopPropagation>↑</button>
                                    <button title="Move down" disabled="@(item.Order == Definition.Fields.Count - 1)" @onclick="() => Move(item.Id, 1)" @onclick:stopPropagation>↓</button>
                                    <button class="danger" title="Remove" @onclick="() => Remove(item.Id)" @onclick:stopPropagation>×</button>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (showJson)
                {
                    <pre class="json-preview">@SerializedDefinition</pre>
                }
            </main>

            <aside class="designer-panel properties" aria-label="Field properties">
                <h2>Languages</h2>
                <LanguageSelector Languages="Definition.Localization.Languages" LanguageCodes="Definition.LanguageCodes"
                                  DefaultLanguageCode="Definition.Localization.DefaultLanguageCode" Changed="MarkDirty" TestId="form-languages" />
                <h3>Form title translations</h3>
                <LocalizedTextEditor Definition="Definition.Title" Languages="Definition.Localization.Languages"
                                     LanguageCodes="Definition.LanguageCodes" Changed="MarkDirty" />
                <details>
                    <summary>Add language</summary>
                    <div class="language-add">
                        <input aria-label="Form language code" placeholder="ar" @bind="newLanguageCode" />
                        <input aria-label="Form language name" placeholder="العربية" @bind="newLanguageName" />
                        <label class="checkbox"><input type="checkbox" @bind="newLanguageIsRtl" /> RTL</label>
                        <button data-testid="add-form-language" class="secondary" @onclick="AddLanguage">Add language</button>
                    </div>
                </details>
                <h2>Properties</h2>
                @{ var selectedItem = SelectedField; }
                @if (selectedItem is null)
                {
                    <p class="muted">Select a field on the canvas to edit it.</p>
                }
                else
                {
                    <span class="type-badge">@selectedItem.Type</span>
                    <label>Label<input @bind="selectedItem.Label" @bind:event="oninput" @bind:after="MarkDirty" /></label>
                    <label>Key<input @bind="selectedItem.Key" @bind:event="oninput" @bind:after="MarkDirty" /></label>
                    <label>Placeholder<input @bind="selectedItem.Placeholder" @bind:event="oninput" @bind:after="MarkDirty" /></label>
                    <h3>Label translations</h3>
                    <LocalizedTextEditor Definition="selectedItem.LabelResource" Languages="Definition.Localization.Languages"
                                         LanguageCodes="Definition.LanguageCodes" Changed="MarkDirty" />
                    <h3>Placeholder translations</h3>
                    <LocalizedTextEditor Definition="selectedItem.PlaceholderResource" Languages="Definition.Localization.Languages"
                                         LanguageCodes="Definition.LanguageCodes" Changed="MarkDirty" />
                    <label class="checkbox"><input type="checkbox" @bind="selectedItem.IsRequired" @bind:after="MarkDirty" /> Required</label>

                    @if (SelectedFieldIssues.Count > 0)
                    {
                        <ul class="property-errors">
                            @foreach (var issue in SelectedFieldIssues)
                            {
                                <li>@issue.Message</li>
                            }
                        </ul>
                    }
                }
            </aside>
        </div>
    }
</div>

@code {
    private FormDefinition Definition = FormDefinitionService.Create("Customer intake");
    private IReadOnlyList<IFormFieldPlugin> Plugins = [];
    private IReadOnlyDictionary<string, IFormFieldPlugin> PluginsByType = new Dictionary<string, IFormFieldPlugin>();
    private Guid? selectedFieldId;
    private bool showJson;
    private bool isPreview;
    private bool validationRequested;
    private bool saveSucceeded;
    private string? statusMessage;
    private Guid? draggedFieldId;
    private string? draggedPluginType;
    private string newLanguageCode = string.Empty;
    private string newLanguageName = string.Empty;
    private bool newLanguageIsRtl;

    private FormFieldDefinition? SelectedField =>
        Definition.Fields.FirstOrDefault(item => item.Id == selectedFieldId);

    private IReadOnlyList<FormValidationIssue> DefinitionIssues => FormDefinitionValidator.Validate(Definition);

    private IReadOnlyList<FormValidationIssue> SelectedFieldIssues => DefinitionIssues
        .Where(issue => issue.FieldId == selectedFieldId)
        .ToArray();

    private string SerializedDefinition => System.Text.Json.JsonSerializer.Serialize(
        Definition,
        new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

    protected override async Task OnInitializedAsync()
    {
        Plugins = AvailablePlugins.OrderBy(plugin => plugin.DisplayName).ToArray();
        PluginsByType = Plugins.ToDictionary(plugin => plugin.Type, StringComparer.OrdinalIgnoreCase);

        try
        {
            Definition = await Store.LoadAsync() ?? Definition;
            FormDefinitionService.NormalizeLocalization(Definition);
            if (Definition.Fields.Count > 0)
            {
                statusMessage = "Draft restored";
                saveSucceeded = true;
            }
        }
        catch (Exception exception) when (exception is InvalidOperationException or System.Text.Json.JsonException or JSException)
        {
            statusMessage = "Saved draft could not be restored";
        }
    }

    private void AddFirstField()
    {
        if (Plugins.Count > 0)
        {
            AddField(Plugins[0]);
        }
    }

    private void AddField(IFormFieldPlugin plugin)
    {
        AddField(plugin, Definition.Fields.Count);
    }

    private void AddField(IFormFieldPlugin plugin, int index)
    {
        var key = FormDefinitionService.CreateUniqueKey(Definition, plugin.Type);
        var item = plugin.CreateField(key);
        item.LabelResource.Key = $"forms.{Definition.Id:N}.fields.{key}.label";
        item.LabelResource.Values[Definition.Localization.DefaultLanguageCode] = item.Label;
        item.PlaceholderResource.Key = $"forms.{Definition.Id:N}.fields.{key}.placeholder";
        item.PlaceholderResource.Values[Definition.Localization.DefaultLanguageCode] = item.Placeholder ?? string.Empty;
        FormDefinitionService.AddField(Definition, item);
        FormDefinitionService.MoveFieldToIndex(Definition, item.Id, index);
        selectedFieldId = item.Id;
        MarkDirty();
    }

    private void Select(Guid fieldId) => selectedFieldId = fieldId;

    private void BeginPluginDrag(string pluginType)
    {
        draggedPluginType = pluginType;
        draggedFieldId = null;
    }

    private void BeginFieldDrag(Guid fieldId)
    {
        draggedFieldId = fieldId;
        draggedPluginType = null;
    }

    private void DropBefore(Guid targetFieldId)
    {
        var index = Definition.Fields.FindIndex(item => item.Id == targetFieldId);
        DropAt(index);
    }

    private void DropAtEnd() => DropAt(Definition.Fields.Count);

    private void DropAt(int index)
    {
        if (draggedPluginType is not null && PluginsByType.TryGetValue(draggedPluginType, out var plugin))
        {
            AddField(plugin, index);
        }
        else if (draggedFieldId is { } fieldId)
        {
            FormDefinitionService.MoveFieldToIndex(Definition, fieldId, index);
            selectedFieldId = fieldId;
            MarkDirty();
        }

        draggedPluginType = null;
        draggedFieldId = null;
    }

    private void Remove(Guid fieldId)
    {
        FormDefinitionService.RemoveField(Definition, fieldId);
        if (selectedFieldId == fieldId)
        {
            selectedFieldId = null;
        }

        MarkDirty();
    }

    private void Move(Guid fieldId, int offset)
    {
        if (FormDefinitionService.MoveField(Definition, fieldId, offset))
        {
            MarkDirty();
        }
    }

    private async Task SaveAsync()
    {
        validationRequested = true;
        if (DefinitionIssues.Count > 0)
        {
            statusMessage = "Form has validation errors";
            saveSucceeded = false;
            return;
        }

        FormDefinitionService.Touch(Definition);
        try
        {
            await Store.SaveAsync(Definition);
            statusMessage = "Saved locally";
            saveSucceeded = true;
        }
        catch (JSException)
        {
            statusMessage = "Browser storage is unavailable";
            saveSucceeded = false;
        }
    }

    private void MarkDirty()
    {
        statusMessage = "Unsaved changes";
        saveSucceeded = false;
    }

    private void ToggleJson() => showJson = !showJson;

    private void TogglePreview() => isPreview = !isPreview;

    private void AddLanguage()
    {
        var code = newLanguageCode.Trim().ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(code) || Definition.Localization.Languages.Any(language =>
            string.Equals(language.Code, code, StringComparison.OrdinalIgnoreCase)))
        {
            statusMessage = "Enter a unique language code";
            saveSucceeded = false;
            return;
        }

        Definition.Localization.Languages.Add(new()
        {
            Code = code,
            DisplayName = string.IsNullOrWhiteSpace(newLanguageName) ? code.ToUpperInvariant() : newLanguageName.Trim(),
            Direction = newLanguageIsRtl ? ContentDirection.RightToLeft : ContentDirection.LeftToRight
        });
        PageBuilderService.ToggleLanguage(Definition.LanguageCodes, code, true, Definition.Localization.DefaultLanguageCode);
        newLanguageCode = string.Empty;
        newLanguageName = string.Empty;
        newLanguageIsRtl = false;
        MarkDirty();
    }
}
