<div class="language-selector" data-testid="@TestId">
    @foreach (var language in Languages)
    {
        var selected = LanguageCodes.Contains(language.Code, StringComparer.OrdinalIgnoreCase);
        var isDefault = string.Equals(language.Code, DefaultLanguageCode, StringComparison.OrdinalIgnoreCase);
        <label>
            <input type="checkbox" checked="@selected" disabled="@isDefault"
                   @onchange="args => Toggle(language.Code, IsChecked(args.Value))" />
            <span>@language.DisplayName <small>@language.Code · @(language.Direction == ContentDirection.RightToLeft ? "RTL" : "LTR")</small></span>
        </label>
    }
</div>

@code {
    [Parameter, EditorRequired] public required IReadOnlyList<LanguageDefinition> Languages { get; set; }
    [Parameter, EditorRequired] public required List<string> LanguageCodes { get; set; }
    [Parameter, EditorRequired] public required string DefaultLanguageCode { get; set; }
    [Parameter] public string? TestId { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private async Task Toggle(string code, bool enabled)
    {
        PageBuilderService.ToggleLanguage(LanguageCodes, code, enabled, DefaultLanguageCode);
        await Changed.InvokeAsync();
    }

    private static bool IsChecked(object? value) => value is bool enabled
        ? enabled
        : bool.TryParse(value?.ToString(), out var parsed) && parsed;
}
