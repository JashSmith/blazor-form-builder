@implements IAsyncDisposable

<footer class="status-footer" dir="@Direction">
    <div class="footer-main">
        <span>@Definition.Copyright.Resolve(LanguageCode, Definition.CopyrightText)</span>
        <nav>
            @foreach (var link in Definition.Links)
            {
                <span>@link.LabelResource.Resolve(LanguageCode, link.Label)</span>
            }
        </nav>
    </div>
    @if (Definition.Widgets.Count > 0)
    {
        <div class="status-widgets">
            @if (Definition.Widgets.Contains(FooterWidgetKind.Messages))
            {
                <span title="Messages">✉ @WidgetText(FooterWidgetKind.Messages, "0 messages")</span>
            }
            @if (Definition.Widgets.Contains(FooterWidgetKind.Logs))
            {
                <span title="Logs">≡ @WidgetText(FooterWidgetKind.Logs, "Logs ready")</span>
            }
            @if (Definition.Widgets.Contains(FooterWidgetKind.Progress))
            {
                <span class="progress-widget" title="Progress"><i><b></b></i> @WidgetText(FooterWidgetKind.Progress, "35%")</span>
            }
            @if (Definition.Widgets.Contains(FooterWidgetKind.Connection))
            {
                <span title="Connection"><em></em> @WidgetText(FooterWidgetKind.Connection, "Online")</span>
            }
            @if (Definition.Widgets.Contains(FooterWidgetKind.Clock))
            {
                <span title="Clock">◷ @currentTime</span>
            }
        </div>
    }
</footer>

@code {
    [Parameter, EditorRequired]
    public required FooterDefinition Definition { get; set; }

    [Parameter] public string? LanguageCode { get; set; }

    [Parameter] public string Direction { get; set; } = "ltr";

    private readonly CancellationTokenSource cancellation = new();
    private PeriodicTimer? timer;
    private string currentTime = DateTime.Now.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture);

    private string WidgetText(FooterWidgetKind kind, string fallback) =>
        Definition.WidgetLabels.TryGetValue(kind, out var label) ? label.Resolve(LanguageCode, fallback) : fallback;

    protected override void OnInitialized()
    {
        timer = new(TimeSpan.FromSeconds(1));
        _ = UpdateClockAsync();
    }

    private async Task UpdateClockAsync()
    {
        if (timer is null)
        {
            return;
        }

        try
        {
            while (await timer.WaitForNextTickAsync(cancellation.Token))
            {
                currentTime = DateTime.Now.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposal stops the clock loop.
        }
    }

    public ValueTask DisposeAsync()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
