<HeadContent>
    <title>Blazor Form Builder</title>
    <meta name="description" content="Plugin-first form designer built with Blazor WebAssembly." />
</HeadContent>

<ErrorBoundary>
    <ChildContent>
        <BuilderWorkspace />
    </ChildContent>
    <ErrorContent Context="error">
        <main class="fatal-error">
            <h1>The builder could not start</h1>
            <p>@error.Message</p>
            <button onclick="window.location.reload()">Reload application</button>
        </main>
    </ErrorContent>
</ErrorBoundary>
