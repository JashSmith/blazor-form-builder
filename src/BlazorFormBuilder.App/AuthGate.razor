@inject AuthenticationClient Authentication
@inject TenantSessionState TenantSession

@if (isLoading)
{
    <main class="auth-loading">Checking your session…</main>
}
else if (session is null)
{
    <main class="auth-shell">
        <section class="auth-intro">
            <span class="brand-mark">BF</span>
            <p class="eyebrow">BLAZOR FORM BUILDER</p>
            <h1>Build forms and pages in one secure workspace.</h1>
            <p>Every organization gets an isolated tenant. Your drafts, reusable headers, footers, and forms stay inside that workspace.</p>
            <ul>
                <li>Guided multilingual builders</li>
                <li>Responsive RTL/LTR previews</li>
                <li>Owner, editor, and viewer access</li>
            </ul>
        </section>

        <section class="auth-card">
            <div class="auth-tabs">
                <button data-testid="show-login" class="@(mode == AuthMode.Login ? "active" : null)" @onclick="() => SetMode(AuthMode.Login)">Sign in</button>
                <button data-testid="show-register" class="@(mode == AuthMode.Register ? "active" : null)" @onclick="() => SetMode(AuthMode.Register)">Create</button>
                <button data-testid="show-invitation" class="@(mode == AuthMode.Invitation ? "active" : null)" @onclick="() => SetMode(AuthMode.Invitation)">Join</button>
            </div>

            <h2>@Title</h2>
            <p>@Description</p>

            @if (mode == AuthMode.Register)
            {
                <label>Organization name<input data-testid="tenant-name" autocomplete="organization" @bind="tenantName" /></label>
            }
            else if (mode == AuthMode.Login)
            {
                <label>Tenant slug<input data-testid="tenant-slug" autocomplete="organization" @bind="tenantSlug" /></label>
            }
            else
            {
                <label>Invitation token<textarea data-testid="invitation-token" rows="3" @bind="invitationToken"></textarea></label>
            }

            @if (mode != AuthMode.Invitation)
            {
                <label>Email<input data-testid="auth-email" type="email" autocomplete="email" @bind="email" /></label>
            }
            <label>Password<input data-testid="auth-password" type="password" autocomplete="@(mode == AuthMode.Login ? "current-password" : "new-password")" @bind="password" /></label>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="auth-error" role="alert">@errorMessage</div>
            }

            <button data-testid="submit-auth" class="submit" disabled="@isSubmitting" @onclick="SubmitAsync">
                @(isSubmitting ? "Please wait…" : SubmitLabel)
            </button>
        </section>
    </main>
}
else
{
    <header class="session-bar">
        <div><strong>@session.TenantSlug</strong><span>@session.Email · @session.Role</span></div>
        @if (session.Role == TenantRole.Owner)
        {
            <button data-testid="manage-team" class="@(showTeam ? "active" : null)" @onclick="() => showTeam = !showTeam">Team</button>
        }
        <button data-testid="logout" @onclick="LogoutAsync">Sign out</button>
    </header>
    @if (showTeam && session.Role == TenantRole.Owner)
    {
        <TenantMembersPanel OnClose="() => showTeam = false" />
    }
    <BuilderWorkspace @key="session.TenantId" />
}

@code {
    private SessionInfo? session;
    private AuthMode mode;
    private bool isLoading = true;
    private bool isSubmitting;
    private bool showTeam;
    private string tenantName = string.Empty;
    private string tenantSlug = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string invitationToken = string.Empty;
    private string? errorMessage;

    private string Title => mode switch
    {
        AuthMode.Register => "Create your tenant",
        AuthMode.Invitation => "Join a workspace",
        _ => "Welcome back"
    };

    private string Description => mode switch
    {
        AuthMode.Register => "The first account becomes the tenant owner.",
        AuthMode.Invitation => "Paste the one-time token shared by your workspace owner.",
        _ => "Enter your tenant slug and account details."
    };

    private string SubmitLabel => mode switch
    {
        AuthMode.Register => "Create workspace",
        AuthMode.Invitation => "Accept invitation",
        _ => "Sign in"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            session = await Authentication.GetSessionAsync();
            SetSessionState();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The authentication server is unavailable.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage = "Run the hosted API project to sign in.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetMode(AuthMode value)
    {
        mode = value;
        errorMessage = null;
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;
        var missingCredentials = string.IsNullOrWhiteSpace(password) || (mode switch
        {
            AuthMode.Register => string.IsNullOrWhiteSpace(tenantName) || string.IsNullOrWhiteSpace(email),
            AuthMode.Invitation => string.IsNullOrWhiteSpace(invitationToken),
            _ => string.IsNullOrWhiteSpace(tenantSlug) || string.IsNullOrWhiteSpace(email)
        });
        if (missingCredentials)
        {
            errorMessage = "Complete every field before continuing.";
            return;
        }

        isSubmitting = true;
        try
        {
            var result = mode switch
            {
                AuthMode.Register => await Authentication.RegisterAsync(new(tenantName, email, password)),
                AuthMode.Invitation => await Authentication.AcceptInvitationAsync(new(invitationToken, password)),
                _ => await Authentication.LoginAsync(new(tenantSlug, email, password))
            };
            session = result.Session;
            errorMessage = result.Error;
            SetSessionState();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The authentication server is unavailable.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void SetSessionState()
    {
        if (session is not null)
        {
            TenantSession.SetSession(session);
        }
    }

    private async Task LogoutAsync()
    {
        await Authentication.LogoutAsync();
        TenantSession.Clear();
        session = null;
        showTeam = false;
        password = string.Empty;
    }

    private enum AuthMode
    {
        Login,
        Register,
        Invitation
    }
}
